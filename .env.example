# Copy to .env (already git-ignored). Real environment variables take precedence.
# Get a key from https://aistudio.google.com/apikey - keep it on the PC only.
GEMINI_API_KEY=
# MIMO_LLM_PROVIDER=ollama        # ollama | gemini | auto
# MIMO_LLM_FALLBACK=true
# MIMO_OLLAMA_URL=http://127.0.0.1:11434
# MIMO_OLLAMA_MODEL=qwen2.5:1.5b
# MIMO_GEMINI_MODEL=gemini-3.1-flash-lite
# Require a paired-device token on every route (pair the PC first, then turn this on).
# MIMO_REQUIRE_AUTH=1
# Where the backend keeps data/security.db, conversations.db, agent.db (default: ./data)
# MIMO_DATA_DIR=
# Extra CORS origins for a local web UI (comma separated); browsers on localhost are allowed by default.
# MIMO_CORS_ORIGINS=http://localhost:5173
